EXPO_PUBLIC_API_URL=http://localhost:3001
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Only use /Tinball when publishing to https://USER.github.io/Tinball/
EXPO_PUBLIC_BASE_PATH=
EXPO_PUBLIC_TERMS_URL=https://tinball.example/terminos
EXPO_PUBLIC_PRIVACY_URL=https://tinball.example/privacidad
EXPO_PUBLIC_COMMUNITY_RULES_URL=https://tinball.example/comunidad
# Demo is additionally guarded by __DEV__; this cannot enable production auth bypass.
EXPO_PUBLIC_ENABLE_DEMO_MODE=true
