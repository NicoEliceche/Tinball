{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "allowImportingTsExtensions": false,
    "moduleSuffixes": [".ios", ".android", ".native", ".web", ""],
    "noUncheckedIndexedAccess": true,
    "strict": true
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"]
}
