# API runtime (Render)
NODE_ENV=development
PORT=3001
API_PUBLIC_URL=http://localhost:3001
WEB_PUBLIC_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,https://nicoeliceche.github.io

# Neon: pooled URL for application traffic; direct URL for migrations/backups.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/tinball?sslmode=require
DIRECT_URL=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/tinball?sslmode=require

# Generate with: openssl rand -base64 48
SESSION_PEPPER=replace-with-at-least-32-random-characters
AUDIT_HASH_SECRET=replace-with-a-different-random-secret
IP_HASH_SECRET=replace-with-a-third-random-secret

# Google OAuth server verification. Keep platform clients independent.
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=

# Production security dependencies. Production health fails closed if absent.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
WORKER_SECRET=
SECURITY_ALERT_WEBHOOK_URL=
SECURITY_ALERT_WEBHOOK_TOKEN=

# High-risk features remain disabled until legal/compliance approval.
ENABLE_PRIZE_LOBBIES=false
ENABLE_REFERRAL_PAYOUTS=false
ENABLE_VENUE_BOOKINGS=false
ENABLE_PREMIUM_PURCHASES=false
